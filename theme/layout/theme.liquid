<!-- Structured data: Organization/Store + WebSite + Product catalog + FAQ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": [
        "Organization",
        "Store"
      ],
      "@id": "https://emberandiron.pk/#org",
      "name": "Ember & Iron",
      "url": "https://emberandiron.pk/",
      {%- if shop.brand.logo %}
      "logo": {{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      {%- if share_image %}
      "image": {{ share_image | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif %}
      "description": "Hand-built BBQ grills, smokers, charcoal and fire tools for Eid tikka, camping, picnics, winter cookouts and outdoor hosting across Pakistan.",
      "slogan": "Fire, built for generations.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      },
      "areaServed": [
        {
          "@type": "Country",
          "name": "Pakistan"
        },
        {
          "@type": "City",
          "name": "Lahore"
        },
        {
          "@type": "City",
          "name": "Karachi"
        },
        {
          "@type": "City",
          "name": "Islamabad"
        }
      ],
      "knowsAbout": [
        "BBQ grills",
        "charcoal",
        "smokers",
        "camping",
        "outdoor cooking",
        "picnic",
        "Eid",
        "tikka",
        "chicken BBQ",
        "winter grilling",
        "fire tools"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "areaServed": "PK",
        "availableLanguage": [
          "en",
          "ur"
        ],
        "email": "hello@emberandiron.pk"
      },
      "sameAs": [
        "https://www.instagram.com/emberandiron",
        "https://www.facebook.com/emberandiron"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://emberandiron.pk/#website",
      "url": "https://emberandiron.pk/",
      "name": "Ember & Iron",
      "description": "BBQ grills, smokers, charcoal and grilling accessories in Pakistan.",
      "inLanguage": "en-PK",
      "publisher": {
        "@id": "https://emberandiron.pk/#org"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://emberandiron.pk/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://emberandiron.pk/#catalog",
      "name": "BBQ Grills, Charcoal & Accessories",
      "numberOfItems": {{ collections.all.products_count }},
      "itemListElement": [
        {%- for product in collections.all.products limit: 50 %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "item": {
            "@type": "Product",
            "@id": {{ shop.url | append: product.url | append: '#product' | json }},
            "name": {{ product.title | json }},
            {%- if product.selected_or_first_available_variant.sku != blank %}
            "sku": {{ product.selected_or_first_available_variant.sku | json }},
            {%- endif %}
            "description": {{ product.description | strip_html | strip_newlines | truncate: 300 | json }},
            "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
            "category": {{ product.type | json }},
            {%- if product.featured_image %}
            "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
            {%- endif %}
            "url": {{ shop.url | append: product.url | json }},
            "offers": {
              "@type": "Offer",
              "price": {{ product.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ shop.currency | json }},
              "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
              "itemCondition": "https://schema.org/NewCondition",
              "url": {{ shop.url | append: product.url | json }}
            }
          }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://emberandiron.pk/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you deliver BBQ grills, charcoal and smokers across Pakistan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — we deliver grills, smokers, charcoal and accessories across Pakistan, with free delivery in Lahore, Karachi and Islamabad on orders over Rs 12,000."
          }
        },
        {
          "@type": "Question",
          "name": "Which grill is best for Eid, tikka parties and hosting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For Eid, tikka nights, festivals and hosting, our 30-inch collapsible grills with a grilling top give you the most cooking surface for chicken, koftas and beef tikka."
          }
        },
        {
          "@type": "Question",
          "name": "Are your grills good for camping, picnics and outdoor adventures?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. Our collapsible charcoal grills fold flat and are light enough to carry for camping, picnics, beach trips and outdoor adventures."
          }
        },
        {
          "@type": "Question",
          "name": "What charcoal or coal do you recommend for BBQ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend our single-origin acacia lump charcoal for a clean, long, hot burn — perfect for BBQ, chicken tikka and low-and-slow smoking."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use a charcoal grill in winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — charcoal grilling is a winter favourite for warm gatherings. Our fire starters and handheld air blower get coals glowing fast even on cold evenings."
          }
        },
        {
          "@type": "Question",
          "name": "Do your grills and smokers come with a warranty?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every hand-built cookbox carries a lifetime warranty against burn-through, and accessories carry a 1-year warranty."
          }
        }
      ]
    }
  ]
}
</script>

