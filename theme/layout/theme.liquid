{%- comment -%}
  Store policies (Settings > Policies) render here as plain server-side pages.
  The single-page app below doesn't know the /policies/* URLs, so a direct
  visit (Google, Merchant Center, a shared link, the checkout footer) used to
  fall through to its 404 view, with Shopify's policy text hidden in the
  display:none div at the bottom. Rendering them here makes the official,
  checkout-linked policy the one shoppers and crawlers actually see.
{%- endcomment -%}
{%- if request.page_type == 'policy' -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#16110D">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root{--paper:#16110D;--ink:#F2EBDE;--ink-soft:#D9CFBF;--muted-soft:#A09280;--on-dark:#F4EFE6;--ember:#E8571F;--line:rgba(242,235,222,0.14)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Figtree',sans-serif;background:var(--paper);color:var(--ink);line-height:1.7;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:820px;margin:0 auto;padding:0 24px}
    .site-head{position:sticky;top:0;z-index:10;background:rgba(22,17,13,0.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
    .site-head .wrap{max-width:none;display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 40px}
    .brand{font-weight:800;letter-spacing:-0.01em;font-size:1.15rem;color:var(--on-dark)}
    .brand em{color:var(--ember);font-style:normal}
    .site-nav{display:flex;gap:22px}
    .site-nav a{color:var(--ink-soft);font-weight:500;font-size:.95rem}
    .site-nav a:hover{color:var(--ember)}
    main{padding:48px 0 24px}
    .shopify-policy__title h1{font-size:2.2rem;font-weight:800;letter-spacing:-0.02em;line-height:1.15;color:var(--on-dark);margin-bottom:28px}
    .rte{color:var(--ink-soft)}
    .rte h2,.rte h3,.rte h4{color:var(--ink);margin:28px 0 10px;line-height:1.3}
    .rte p,.rte ul,.rte ol{margin:12px 0}
    .rte ul,.rte ol{padding-left:22px}
    .rte a{color:var(--ember);text-decoration:underline}
    .rte strong{color:var(--ink)}
    .site-foot{border-top:1px solid var(--line);margin-top:56px;padding:32px 0;color:var(--muted-soft);font-size:.9rem}
    .policy-links{display:flex;flex-wrap:wrap;gap:10px 22px;margin-bottom:16px}
    .policy-links a:hover,.policy-links a[aria-current]{color:var(--ember)}
    @media(max-width:520px){.site-head .wrap{height:56px;padding:0 20px}.brand{font-size:1rem}.site-nav{gap:14px}.site-nav a{font-size:.85rem}.shopify-policy__title h1{font-size:1.7rem}}
  </style>
</head>
<body>
  <header class="site-head">
    <div class="wrap">
      <a href="{{ routes.root_url }}" class="brand">Ember <em>&amp;</em> Iron</a>
      <nav class="site-nav" aria-label="Store">
        <a href="{{ routes.root_url }}">Shop</a>
        <a href="/pages/contact">Contact</a>
        <a href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
      </nav>
    </div>
  </header>
  <main class="wrap">{{ content_for_layout }}</main>
  <footer class="site-foot">
    <div class="wrap">
      <nav class="policy-links" aria-label="Policies">
        {%- for policy in shop.policies %}
        <a href="{{ policy.url }}"{% if policy.url == request.path %} aria-current="page"{% endif %}>{{ policy.title }}</a>
        {%- endfor %}
        <a href="/pages/contact">Contact</a>
      </nav>
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &mdash; Hand-built BBQ grills, Pakistan</span>
    </div>
  </footer>
</body>
</html>
{%- else -%}
