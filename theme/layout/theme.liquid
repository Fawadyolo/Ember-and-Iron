<section class="hero hero-video">
  <video class="hero-bg-video" id="hero-video" autoplay muted loop playsinline preload="auto" aria-hidden="true" data-poster-mobile="data:image/jpeg;base64," poster="data:image/jpeg;base64,">
    <source src="https://cdn.shopify.com/s/files/1/0832/3498/0059/files/hero-mobile.mp4?v=1783789472" media="(max-width: 760px)" type="video/mp4">
    <source src="https://cdn.shopify.com/s/files/1/0832/3498/0059/files/hero-1080.mp4?v=1783752384" type="video/mp4">
  </video>
  <script>
  /* Hero poster: the markup carries the desktop still so the preload scanner has
     something valid; phones get the portrait still instead. Inline and un-deferred
     on purpose — this must run before first paint, not at DOMContentLoaded. */
  (function(){
    var v = document.getElementById('hero-video');
    if (!v) return;
    var m = v.getAttribute('data-poster-mobile');
    if (m && window.matchMedia('(max-width: 760px)').matches) v.poster = m;
  })();
  </script>
