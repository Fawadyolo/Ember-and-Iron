{% layout 'product' %}
<script>
/* The storefront's info pages (/faq, /shipping, ...) and the accessories/wishlist
   views are client-side routes on the homepage — as real URLs Shopify has nothing
   to serve, so a shared or refreshed link used to dead-end here. Hand those few
   known routes back to the homepage, which restores the view. Anything else keeps
   the real 404 below (and its 404 status), so genuine dead links stay dead. */
(function () {
  var SPA = ['accessories','wishlist','orders','order-confirmed',
             'shipping','returns','warranty','care','privacy','terms','about','faq','contact'];
  var seg = location.pathname.replace(/^\/+|\/+$/g, '');
  if (SPA.indexOf(seg) !== -1) location.replace('/?spa=' + encodeURIComponent(seg));
})();
</script>
<div class="wrap" style="text-align:center;padding:80px 24px">
  <div class="pdp-cat">404 — Not found</div>
  <h1 style="font-size:2.3rem;font-weight:800;color:var(--on-dark);margin:12px 0">This page went cold.</h1>
  <p style="color:var(--ink-soft);max-width:480px;margin:0 auto 28px">The link you followed doesn't exist any more — but the fire's still going on the main store.</p>
  <div class="pdp-cta" style="justify-content:center">
    <a class="btn" href="{{ routes.root_url }}">Back to the store</a>
    <a class="btn btn-ghost" href="{{ collections.grills.url }}">Shop grills</a>
    <a class="btn btn-ghost" href="{{ collections.accessories.url }}">Accessories</a>
  </div>
</div>
