{% layout 'product' %}
{%- comment -%}
  Shopify's built-in policy pages (privacy, refund/returns, terms, shipping) had
  no template, so they fell through to the SPA layout where content_for_layout is
  hidden — the pages returned 200 but rendered blank. Render them through the same
  clean 'product' layout every other real page uses, mirroring templates/page.liquid.
{%- endcomment -%}
<div class="wrap">
  <nav class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ policy.title }}</nav>
  <header class="coll-head">
    <h1>{{ policy.title }}</h1>
  </header>
  <div class="pdp-desc" style="max-width:760px;margin:24px 0 64px">
    {{ policy.body }}
  </div>
</div>
